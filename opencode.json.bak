    },
    "openspec-archive-change": {
      "autoUpdate": false,
      "source": "local",
      "version": "1.0"
    },
    "openspec-explore": {
      "autoUpdate": false,
      "source": "local",
      "version": "1.0"
    },
    "openspec-propose": {
      "autoUpdate": false,
      "source": "local",
      "version": "1.0"
    },
    "smol-developer": {
      "autoUpdate": true,
      "updateInterval": "weekly",
      "source": "npm:smol-developer",
      "version": "1.0.0"
    },
    "understand-anything": {
      "autoUpdate": true,
      "updateInterval": "commit",
      "source": "https://github.com/Lum1104/Understand-Anything.git",
      "version": "1.0.0"
    },
    "supabase": {
      "autoUpdate": true,
