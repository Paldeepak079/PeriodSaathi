{
  "$schema": "https://opencode.ai/schemas/opencode.json",
  "version": 1,
  "skills": {
    "agent-almanac": {
      "autoUpdate": true,
      "updateInterval": "weekly",
      "source": "https://github.com/BehiSecc/awesome-claude-skills.git",
      "version": "1.0.0"
    },
    "ai-code-review": {
      "autoUpdate": true,
      "updateInterval": "weekly",
      "source": "https://github.com/nuekkis/AI-Code-Review.git",
      "version": "1.0.0"
    },
    "ai-review": {
      "autoUpdate": true,
      "updateInterval": "weekly",
      "source": "https://github.com/Nikita-Filonov/ai-review.git",
      "version": "1.0.0"
    },
    "awesome-ai-agents": {
      "autoUpdate": true,
      "updateInterval": "weekly",
      "source": "https://github.com/ARUNAGIRINATHAN-K/awesome-ai-agents-2026.git",
      "version": "1.0.0"
    },
    "caveman": {
      "autoUpdate": true,
      "updateInterval": "weekly",
      "source": "npm:caveman",
      "version": "1.0.0"
    },
    "graphify": {
      "autoUpdate": true,
      "updateInterval": "commit",
